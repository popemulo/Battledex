# Copy to .env.local for `vercel dev`, and set the same names in the Vercel project settings.

# Required for real verdicts (Stage 4). Never commit the real value.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=

# Optional but recommended in production: shared storage for the per-IP rate limit.
# Without these, the limit is counted in memory per function instance (best effort only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
